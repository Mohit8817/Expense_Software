# Copy to .env and set your values. Never commit real secrets.

NODE_ENV=development
PORT=5001

DATABASE_URL=mysql://user:password@localhost:3306/klkexpense

JWT_SECRET=change_me_to_a_long_random_string
SESSION_SECRET=change_me_to_another_long_random_string

# Optional: comma-separated frontend origins (defaults include localhost + klk.co.in http/https)
# CORS_ORIGINS=http://localhost:5173,https://klk.co.in,https://www.klk.co.in

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Use gpt-4o for better bill OCR accuracy (recommended for scan)
OPENAI_SCAN_MODEL=gpt-4o
